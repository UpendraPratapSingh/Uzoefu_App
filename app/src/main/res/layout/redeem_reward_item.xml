<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvRewardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular"
            android:text="R100 Activity Credit"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/tvPoints"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_points_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="-500 pts"
            android:textColor="@color/red"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvRewardTitle" />

        <TextView
            android:id="@+id/tvRedeemed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Redeemed "
            android:textColor="@color/gray"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRewardTitle" />

        <TextView
            android:id="@+id/tvRedeemedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 October 2027"
            android:textColor="@color/gray"
            android:fontFamily="@font/roboto_medium"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/tvRedeemed"
            app:layout_constraintTop_toTopOf="@+id/tvRedeemed" />

        <TextView
            android:id="@+id/tvCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Confirmation Code "
            android:textColor="@color/gray"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvRedeemed" />

        <TextView
            android:id="@+id/tvCodeCopied"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UZR1234-300978-25"
            android:textColor="@color/gray"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/roboto_medium"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvCode"
            app:layout_constraintStart_toEndOf="@+id/tvCode"
            app:layout_constraintTop_toBottomOf="@+id/tvRedeemed" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
